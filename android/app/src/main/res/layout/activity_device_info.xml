<?xml version="1.0" encoding="utf-8"?>
<!-- 设备信息页：设计稿 ui_design/screens/device_info.png -->
<!-- clipChildren=false：设备卡外阴影（CardShadowDrawable）需向视图边界外绘制，
     否则被裁到卡片矩形内，仅在圆角三角区留下硬边黑块 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/deviceInfoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_gradient"
    android:clipChildren="false"
    android:orientation="vertical">

    <!-- 顶栏：返回（白色圆角方块）+ 居中标题。顶栏不留左右 margin、
         改为按钮自身 marginStart：按钮带 elevation，其左边缘若与顶栏边界重合，
         阴影会向界外扩散并被父布局裁掉一条（真机表现为左边缘轻微模糊）。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:clipChildren="false">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_rec_back_button"
            android:contentDescription="返回"
            android:elevation="2dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back_ios_new" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="设备信息"
            android:textColor="?attr/recorderColorTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 设备卡片。卡片背景（含强调外阴影 Y8/24/8%）由 Activity 设置 CardShadowDrawable。 -->
    <LinearLayout
        android:id="@+id/deviceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="录音笔"
                android:src="@drawable/ic_main_device" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/recorderColorTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSerial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/recorderColorTextSecondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 连接状态徽标 -->
            <LinearLayout
                android:id="@+id/connBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_conn_badge_offline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/ivBadgeDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/bg_status_dot_offline" />

                <TextView
                    android:id="@+id/tvBadgeState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="未连接"
                    android:textColor="?attr/recorderColorTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?attr/recorderColorSurfaceMuted" />

        <!-- 电量 / 存储：已连接时显示设备数值，未连接时显示占位符 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="电量"
                    android:textColor="?attr/recorderColorTextSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="--"
                    android:textColor="?attr/recorderColorTextPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="存储 (可用 / 总计)"
                    android:textColor="?attr/recorderColorTextSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvStorage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="--"
                    android:textColor="?attr/recorderColorTextPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部「解除绑定」按钮。clipChildren=false：按钮红色外阴影向下溢出视图边界 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/btnUnbind"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_unbind_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="解除绑定"
                android:src="@drawable/ic_device_unbind" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="解除绑定"
                android:textColor="?attr/recorderColorOnDanger"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
