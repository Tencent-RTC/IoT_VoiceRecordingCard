<?xml version="1.0" encoding="utf-8"?>
<!-- 主页面（设计稿 main.png / main_without_bound_device.png /
     main_with_bound_device_connecting.png / main_with_bound_device_but_disconnected.png）：
     设备状态卡（四态）+ 最近记录 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- clipChildren/clipToPadding=false：最近记录卡片的外阴影溢出列表边界后延伸到 padding 区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- 顶部：问候语 + 标题 + 用户占位图标。
             clipChildren=false：头像按钮外阴影（ShadowedDrawable）需向视图边界外绘制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/recorderColorTextSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="我的录音"
                    android:textColor="?attr/recorderColorTextPrimary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 右上角 user icon：仅占位，不实现任何功能。
                 白色正圆 + 外阴影（Y4/模糊12/对应 Theme Token 8%）由 HomeScreenView 设置 ShadowedDrawable。 -->
            <FrameLayout
                android:id="@+id/avatarButton"
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="用户"
                    android:src="@drawable/ic_main_user" />
            </FrameLayout>
        </LinearLayout>

        <!-- 设备卡片（未绑定引导 / 已绑定设备 两态内容互斥切换）。
             卡片背景（含强调外阴影 Y8/24/8%）由 HomeScreenView 设置 CardShadowDrawable。 -->
        <LinearLayout
            android:id="@+id/deviceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 未绑定：绑定引导卡（main_without_bound_device.png） -->
            <LinearLayout
                android:id="@+id/bindGuideContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="绑定设备"
                        android:textColor="?attr/recorderColorTextPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="前往「绑定设备」扫描并绑定"
                        android:textColor="?attr/recorderColorTextSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnBindDevice"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_add_device_fab"
                    android:clickable="true"
                    android:contentDescription="绑定设备"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_main_add" />
                </FrameLayout>
            </LinearLayout>

            <!-- 已绑定：设备状态卡（连接中 / 已连接 / 未连接） -->
            <LinearLayout
                android:id="@+id/boundDeviceContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 设备信息区：仅本行可点击进入设备信息页（下方录音区不响应） -->
                <LinearLayout
                    android:id="@+id/deviceInfoRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="录音笔"
                        android:src="@drawable/ic_main_device" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvProductName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/recorderColorTextPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivConnDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:src="@drawable/bg_status_dot_offline" />

                            <TextView
                                android:id="@+id/tvConnState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="未连接"
                                android:textColor="?attr/recorderColorTextSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 电量 / 存储：仅已连接可见；数值为 mock 占位，
                         设备信息上报能力实现后替换为真实数据 -->
                    <LinearLayout
                        android:id="@+id/batteryStorageGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_main_battery" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="电量："
                                android:textColor="?attr/recorderColorTextSecondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvBattery"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="86%"
                                android:textColor="?attr/recorderColorTextPrimary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_main_storage" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="存储："
                                android:textColor="?attr/recorderColorTextSecondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvStorage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12.4 / 64 GB"
                                android:textColor="?attr/recorderColorTextPrimary"
                                android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/recordDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="?attr/recorderColorSurfaceMuted" />

                <!-- 开始录音区：仅已连接可见 -->
                <LinearLayout
                    android:id="@+id/recordSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="轻点开始录音"
                            android:textColor="?attr/recorderColorTextPrimary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="录音将自动保存至设备"
                            android:textColor="?attr/recorderColorTextSecondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnStartRec"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_record_fab"
                        android:clickable="true"
                        android:contentDescription="开始录音"
                        android:enabled="false"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_main_mic" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 最近记录 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="最近记录"
                android:textColor="?attr/recorderColorTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShowAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:text="全部"
                android:textColor="?attr/recorderColorPrimary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecentEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="暂无录音记录，连接设备后将自动同步"
            android:textColor="?attr/recorderColorTextSecondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.recorder.client.RecordingListView
            android:id="@+id/recentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
