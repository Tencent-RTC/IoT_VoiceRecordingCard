<?xml version="1.0" encoding="utf-8"?>
<!-- 实时说话人分段：近似起始时间 + 说话人标签 + 可持续修订的识别文本。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRealtimeSegmentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/recorderColorTextTimestamp"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvRealtimeSpeakerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRealtimeSegmentText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.4"
        android:textColor="?attr/recorderColorTextStrong"
        android:textIsSelectable="true"
        android:textSize="14sp" />
</LinearLayout>
