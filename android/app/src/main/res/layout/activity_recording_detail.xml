<?xml version="1.0" encoding="utf-8"?>
<!-- 录音详情页：设计稿 ui_design/screens/recording_details.png（忽略 AI 摘要区域） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_gradient_detail"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/detailContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

    <!-- 顶栏：返回（白色圆角方块）+ 居中标题 + 分享按钮 -->
    <!-- clipChildren=false：带 elevation 的按钮阴影投射到视图边界外，避免被父布局裁成硬边 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clipChildren="false">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_rec_back_button"
            android:contentDescription="返回"
            android:elevation="2dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back_ios_new" />

        <TextView
            android:id="@+id/tvRecordingDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/recorderColorTextStrong"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 分享：打开应用内分享面板。 -->
        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_rec_back_button"
            android:contentDescription="分享"
            android:elevation="2dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_detail_share" />
    </FrameLayout>

    <!-- 副标题：录制时间 · 时长 ·（转写后追加）发言人数 -->
    <TextView
        android:id="@+id/tvRecordingDetailTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="?attr/recorderColorTextPending"
        android:textSize="13sp" />

    <!-- 中部区域：空态 / 转写中 / 识别结果 三态互斥切换 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/groupTranscribeEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/tvTranscriptionEmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无转写内容"
                android:textColor="?attr/recorderColorTextPending"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnTranscribe"
                android:layout_width="112dp"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_detail_transcribe_button"
                android:minHeight="0dp"
                android:text="转写"
                android:textColor="?attr/recorderColorOnPrimary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupTranscribeLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressTranscribing"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminate="true"
                android:indeterminateTint="?attr/recorderColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="正在转写中..."
                android:textColor="?attr/recorderColorTextPending"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 设计稿：正文内容区宽度固定并水平居中（约屏宽的 91%）；
             滚动条悬浮于内容区右侧之外，不与正文重合 -->
        <ScrollView
            android:id="@+id/groupTranscribeResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fadeScrollbars="false"
            android:paddingBottom="20dp"
            android:scrollbarStyle="outsideOverlay"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp">

                <!-- 无说话人分段时的纯文本兜底（兼容上一迭代落库的数据） -->
                <TextView
                    android:id="@+id/tvAsrResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="?attr/recorderColorTextStrong"
                    android:textIsSelectable="true"
                    android:textSize="15sp" />

                <!-- 说话人分段视图：每块为 头像+发言人·时间 / 文本 -->
                <LinearLayout
                    android:id="@+id/layoutAsrSegments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </FrameLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 底部播放面板：白色顶部圆角卡片，悬浮阴影不被父布局裁剪 -->
    <LinearLayout
        android:id="@+id/playerSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_detail_player_sheet"
        android:clipChildren="false"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <!-- 进度行：当前进度 + 可拖动进度条 + 总时长 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlaybackProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="?attr/recorderColorTextDetailMetadata"
                android:textSize="12sp" />

            <!-- 轨道厚度由 min/maxHeight 精确控制为 4dp 并在 24dp 触控高度内居中；
                 透明 thumb，整段宽度均可拖动 -->
            <SeekBar
                android:id="@+id/sbPlayback"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:max="1000"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progressDrawable="@drawable/bg_detail_seekbar"
                android:splitTrack="false"
                android:thumb="?attr/recorderColorTransparent" />

            <TextView
                android:id="@+id/tvPlaybackDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="?attr/recorderColorTextDetailMetadata"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 控制行：倍速胶囊 / 后退5s / 主播放钮 / 前进5s / 更多（占位） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/btnPlaybackSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_rec_status_chip"
                android:contentDescription="调整播放速度"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp">

                <TextView
                    android:id="@+id/tvPlaybackSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0x"
                    android:textColor="?attr/recorderColorTextStrong"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="2dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_keyboard_arrow_down" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 设计稿无按压波纹反馈：背景透明 -->
                <ImageButton
                    android:id="@+id/btnRewindFiveSeconds"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/recorderColorTransparent"
                    android:contentDescription="倒退 5 秒"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_replay_5" />

                <ImageButton
                    android:id="@+id/btnTogglePlayback"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_detail_play_button"
                    android:contentDescription="播放"
                    android:padding="19dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_detail_play" />

                <ImageButton
                    android:id="@+id/btnForwardFiveSeconds"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/recorderColorTransparent"
                    android:contentDescription="前进 5 秒"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_forward_5" />
            </LinearLayout>

            <!-- 更多：暂不支持，仅占位，不绑定点击行为 -->
            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/recorderColorTransparent"
                android:contentDescription="更多（当前版本暂不支持）"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_detail_more" />
        </FrameLayout>
    </LinearLayout>

    </LinearLayout>

    <!-- 全屏蒙层 + 底部分享面板；显示时覆盖详情内容与底部播放控件。 -->
    <FrameLayout
        android:id="@+id/shareOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/shareScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/recorderColorScrim"
            android:clickable="true"
            android:contentDescription="关闭分享面板"
            android:focusable="true" />

        <include layout="@layout/view_recording_share_panel" />
    </FrameLayout>
</FrameLayout>
