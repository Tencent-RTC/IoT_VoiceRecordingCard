<?xml version="1.0" encoding="utf-8"?>
<!-- 绑定页设备条目：设备图标 + 产品名/序列号 + 「绑定」按钮。
     卡片背景（含品牌色外阴影 Y6/18/6% 对应 Theme Token）由 BindDeviceActivity 设置 CardShadowDrawable。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="录音笔"
        android:src="@drawable/ic_main_device" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/recorderColorTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSerial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/recorderColorTextSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnBind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bind_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="88dp"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:text="绑定"
        android:textColor="?attr/recorderColorOnPrimary"
        android:textSize="14sp" />
</LinearLayout>
