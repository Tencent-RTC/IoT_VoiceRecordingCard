<?xml version="1.0" encoding="utf-8"?>
<!-- 录音详情页的应用内分享面板，系统分享只在用户选择导出文件后才调起。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sharePanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_recording_share_panel"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="分享"
            android:textColor="?attr/recorderColorTextPanelTitle"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseSharePanel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_share_close_button"
            android:contentDescription="关闭分享面板"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_share_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/recorderColorDividerPanel" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="24dp"
        android:text="复制到剪切板"
        android:textColor="?attr/recorderColorTextPanelTitle"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/rowCopyTranscript"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:clickable="true"
        android:contentDescription="复制转写到剪切板"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="转写"
            android:src="@drawable/ic_share_asr_document" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:text="转写"
            android:textColor="?attr/recorderColorTextPanelTitle"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="复制"
            android:src="@drawable/ic_share_copy" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:text="导出文件"
        android:textColor="?attr/recorderColorTextPanelTitle"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/rowExportRecording"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:clickable="true"
        android:contentDescription="导出录音文件"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="录音"
            android:src="@drawable/ic_share_recording_file" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:text="录音"
            android:textColor="?attr/recorderColorTextPanelTitle"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="导出录音"
            android:src="@drawable/ic_share_arrow_right" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowExportTranscript"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:clickable="true"
        android:contentDescription="导出转写文件"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="转写"
            android:src="@drawable/ic_share_asr_document" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:text="转写"
            android:textColor="?attr/recorderColorTextPanelTitle"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="导出转写"
            android:src="@drawable/ic_share_arrow_right" />
    </LinearLayout>
</LinearLayout>
