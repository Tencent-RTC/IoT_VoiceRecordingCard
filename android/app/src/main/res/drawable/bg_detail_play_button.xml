<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页主播放按钮：深绿圆形 + 按压波纹 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/recorderColorRippleOnPrimary">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="?attr/recorderColorSurface" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/recorderColorPrimary" />
        </shape>
    </item>
</ripple>
