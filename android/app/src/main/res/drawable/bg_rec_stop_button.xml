<?xml version="1.0" encoding="utf-8"?>
<!-- 实时录音页结束录音按钮：珊瑚红胶囊 + 按压波纹 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/recorderColorRippleOnPrimary">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="?attr/recorderColorSurface" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/recorderColorRecordingStop" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</ripple>
