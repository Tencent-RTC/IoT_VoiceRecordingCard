<?xml version="1.0" encoding="utf-8"?>
<!-- 页面背景：实时录音页顶部渐变衬片（设计稿 375×260，对应 Theme Token 不透明度 16% → 0%）
     叠加页面底色 对应 Theme Token；渐变从屏幕顶端（含状态栏区域）开始。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/recorderColorPageBackgroundAlt" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="260dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="?attr/recorderColorPageGradientEnd"
                android:startColor="?attr/recorderColorPageGradientStart"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
